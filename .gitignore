# Local tool installs (e.g. git-filter-repo --target)
.tools/

# Dependencies
node_modules/

# Build outputs
dist/
build/
.cursor/rules

# Uploads (now on Cloudflare R2, local files not needed)
/uploads/

# Database dumps (local restore / backup — large, sensitive)
*.dump

# Environment variables
.env
.env.local
.env.*.local

# Cursor (local hook state, continual-learning index)
.cursor/hooks/state/
.cursor/settings.json

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Railway/production log EXPORTS — these are `logs.<timestamp>.json`, which the
# `logs/` and `*.log` rules above do NOT match. They carry real chat IDs and
# were one `git add -A` from being committed to a public repo.
logs.*.json
logs.*.json:*
# Root-level DB backups (the `backup` / `backup_pg14_*.sql` files that were
# previously committed and are still public by SHA). `*.dump` is covered below.
backup
backup*.sql

# Prisma generated clients (ignore both the dir and a symlink named "generated";
# no trailing slash so a symlink isn't accidentally tracked and broken in CI)
prisma-historical/generated
prisma-content/generated
prisma-telegram/generated

# TypeScript cache
*.tsbuildinfo

# Test coverage
coverage/

# Local database dumps (pg_dump)
backups/
.gstack/

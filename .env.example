# ==============================================================================
# LiquidTerminal Backend - Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values for your environment.
# ==============================================================================

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/liquidterminal
DIRECT_URL=postgresql://user:password@localhost:5432/liquidterminal
HISTORICAL_DATABASE_URL=postgresql://user:password@localhost:5432/liquidterminal_historical
# Optional (defaults shown). The Elysium analytics reads use a pool of their own, so slow
# aggregates cannot take the ingestion's connections; each of their statements ends after the
# ceiling below (ms). DATA_BUDGET BK-L-33.
# HISTORICAL_DB_READ_POOL_MAX=10
# Two more pools on the historical database (DATA_BUDGET BK-L-33): the reads a visitor waits for
# (launchpad list, ingestion status), and the aggregates the view scheduler computes in the background.
# HISTORICAL_DB_PAGES_POOL_MAX=8
# HISTORICAL_DB_AGGREGATE_POOL_MAX=5
# HISTORICAL_PAGES_STATEMENT_TIMEOUT_MS=30000
# Elysium views computed at once by the view scheduler (DATA_BUDGET BK-L-37); one heavy view at a time.
# VIEW_SCHEDULER_CONCURRENCY=2
# HISTORICAL_READ_STATEMENT_TIMEOUT_MS=600000
# The writers' pool (the ingestion): ceilings so that nothing waits for ever. A statement ends
# after 10 min, one that waits for a lock gives up after 1 min, a transaction left open and idle
# is closed after 5 min.
# HISTORICAL_WRITE_STATEMENT_TIMEOUT_MS=600000
# HISTORICAL_WRITE_LOCK_TIMEOUT_MS=60000
# HISTORICAL_WRITE_IDLE_IN_TRANSACTION_TIMEOUT_MS=300000

# Elysium ingestion (HypeDexer -> historical DB) and its day rollups. All optional.
# ELYSIUM_INGEST_ENABLED=false stops the ingestion streams in this process (the rollup builder
# runs with them). ELYSIUM_ROLLUPS_ENABLED=false stops building the day rollups and makes the
# analytics read the raw transaction table alone, as before 2026-11-10: set it on every service.
# ELYSIUM_INGEST_ENABLED=true
# ELYSIUM_ROLLUPS_ENABLED=true
# The daily comparison of each closed day of elysium_tx with the provider's own count, and the
# re-read of a day that differs (rows added, corrected or removed: see the status route). It runs
# with the ingestion streams; false stops it alone, without a deploy, if a re-read ever misbehaves.
# ELYSIUM_DAY_CHECK_ENABLED=true
# Its removal of rows the provider no longer lists (asked for one by one, twice, 10 minutes apart,
# never more than the day holds in excess). false keeps the comparison, the inserts and the
# corrections, and removes nothing.
# ELYSIUM_DAY_CHECK_REMOVE=true
# Where a message goes when the ingestion needs a look (a stream that fails or stopped, the
# provider standing still, a closed day that differs, rows left out, an abnormal day of credits,
# the database volume filling up). A Discord or Slack webhook; or Telegram's
# https://api.telegram.org/bot<token>/sendMessage with the chat id below (without the chat id
# Telegram refuses every message: an error says so at start). Without an address the same lines
# go to the log. The loop runs in the process that serves the API, not in an ingestion-only
# worker: the address goes on that service. ELYSIUM_ALERTS_ENABLED=false stops the loop.
# ELYSIUM_ALERT_WEBHOOK_URL=
# ELYSIUM_ALERT_TELEGRAM_CHAT_ID=
# ELYSIUM_ALERTS_ENABLED=true
# Size of the historical database's volume, in bytes: the admin status route
# (GET /elysium/analytics/status/ops) then shows the share in use, and a message goes at 80%
# (100 GB = 107374182400).
# HISTORICAL_DB_VOLUME_BYTES=
# Days of rollups kept (63 by default, never under 10). They take disk on the historical
# database (GET /elysium/analytics/status shows how much); fewer days free it, and the windows
# that reach past them read those days from the raw table again, slower but with the same figures.
# ELYSIUM_ROLLUP_KEEP_DAYS=63
# PROCESS_ROLE=elysium-worker runs the Elysium ingestion and nothing else (no API poller, no
# socket): for a second service built from the same image, next to an API service that has
# ELYSIUM_INGEST_ENABLED=false. Unset: one process does everything.
# PROCESS_ROLE=
CONTENT_DATABASE_URL=postgresql://user:password@localhost:5432/liquidterminal_content
TELEGRAM_DATABASE_URL=postgresql://user:password@localhost:5432/liquidterminal_telegram

# --- Database Pool Configuration ---
DB_POOL_MAX=20
DB_POOL_MIN=2

# --- Redis ---
REDIS_URL=redis://localhost:6379
# Redis is a cache here: the backend turns its AOF off on every connection and
# refreshes the AOF file every 30 min (BGREWRITEAOF) so a restart reloads recent
# data. Unset = in production only; true or false to force it on or off.
# REDIS_AOF_OFF=

# --- Authentication (Privy) ---
JWKS_URL=https://auth.privy.io/api/v1/apps/YOUR_APP_ID/jwks.json
NEXT_PUBLIC_PRIVY_AUDIENCE=YOUR_PRIVY_APP_ID
FIRST_ADMIN_PRIVY_USER_ID=did:privy:xxxxxxxx

# --- Server ---
NODE_ENV=development
PORT=3002
ALLOWED_ORIGINS=http://localhost:3000

# --- Background Jobs ---
LIQUIDATIONS_AGGREGATION_ENABLED=true

# --- Cloudflare R2 (File Uploads) ---
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your-r2-public-url.example.com

# --- Telegram Bot ---
TELEGRAM_BOT_API_KEY=your_telegram_bot_api_key
# TELEGRAM_BOT_API_KEY_SECONDARY=  # Optional: set during key rotation for zero-downtime
TELEGRAM_BOT_USERNAME=your_bot_username

# --- External API Keys ---
HL_INDEXER_API_KEY=your_hl_indexer_api_key
# HypeDexer credits a UTC day, all instances together, before a warning is logged (warning only, never blocks;
# default 1000000, above the ~320k/day background; the Elysium ingestion, ~2.3M/day when enabled, exceeds it on purpose).
# HYPEDEXER_DAILY_CREDIT_BUDGET=1000000
# Hyperfolio (HyperEVM wallet analytics + yields). Server-side only, never shipped to the browser.
# Required in production: without it every /hyperfolio/* route answers 503 HYPERFOLIO_NOT_CONFIGURED.
HYPERFOLIO_API_KEY=your_hyperfolio_api_key
# Global ceiling on upstream Hyperfolio calls per UTC day, shared via Redis (default 50000).
# The paid quota is unknown: 50000 is a guess, set it to the real figure.
# HYPERFOLIO_DAILY_BUDGET=50000
# Concurrent Hyperfolio positions streams (defaults 30 per IP, 500 in all).
# HYPERFOLIO_STREAMS_PER_IP=30
# HYPERFOLIO_STREAMS_TOTAL=500

# --- Traffic limits (optional — sized for many visitors behind one IP) ---
# General per-IP limiter (defaults 200/s, 6000/min, 300000/h).
# RATE_LIMIT_BURST=200
# RATE_LIMIT_MINUTE=6000
# RATE_LIMIT_HOUR=300000
# /indexer/* pass-through per-IP limiter (defaults 300/s, 4000/min).
# PASSTHROUGH_RATE_LIMIT_BURST=300
# PASSTHROUGH_RATE_LIMIT_MINUTE=4000
# Elysium address / contract profile lookups per IP (defaults 20/s, 300/min).
# ADDRESS_LOOKUP_RATE_LIMIT_BURST=20
# ADDRESS_LOOKUP_RATE_LIMIT_MINUTE=300
# One client's share of the 240 billed per-address Elysium lookups a minute (DATA_BUDGET BK-L-18).
# ELYSIUM_USER_LOOKUPS_PER_CLIENT_MINUTE=60
# Request bodies, counted per client (IP or IPv6 /64) before they are parsed, in process memory
# (DATA_BUDGET BK-L-34): bytes of JSON / form bodies a second and a minute.
# BODY_BYTES_PER_SECOND=524288
# BODY_BYTES_PER_MINUTE=8388608
# HTML parsing of the global sanitizer per client per 10 s, in units (one per string that carries
# <, > or &, one per 8 such characters, one per 256 characters; DATA_BUDGET BK-L-35).
# SANITIZE_UNITS_PER_WINDOW=1536
# Last copy of each cached value (served when a refresh fails, and when a live key's refresh
# takes longer than CACHE_LIVE_REFRESH_WAIT_MS). Default keep: ~10 TTLs, at most
# CACHE_LAST_COPY_MAX_S (or 2 TTLs if longer); copies of non-live keys longer than
# CACHE_LAST_COPY_MAX_CHARS (serialized characters) are skipped. Shared fixed-name keys
# (dashboard tiles, builders stats, HIP-4 tokens) opt in to CACHE_SHARED_LAST_COPY_S.
# CACHE_LAST_COPY_MAX_S=600
# CACHE_LAST_COPY_MAX_CHARS=262144
# CACHE_LIVE_REFRESH_WAIT_MS=1500
# CACHE_SHARED_LAST_COPY_S=3600
# /ws connections (defaults: 200 open per client, 10000 in all, 300 new ones per client per minute;
# a client is an IP, or an IPv6 /64).
# WS_MAX_CONNECTIONS_PER_IP=200
# WS_MAX_TOTAL_CONNECTIONS=10000
# WS_MAX_CONNECTIONS_PER_MINUTE=300
# A browser must come from one of ALLOWED_ORIGINS to open /ws (no Origin header is accepted).
# WS_CHECK_ORIGIN=true  # Set to false to switch the check off
# WS_ALLOW_BOT_KEY_IN_QUERY=true  # Set to false once the bot sends 'Authorization: Bot <key>' on the /ws handshake (a key in a URL ends up in proxy logs)
# Order books mirrored at once (default 48, a few MB each).
# L4BOOK_MAX_COINS=48
# Hyperliquid weight a minute for the bridge-reserve scan (default 60).
# BRIDGE_RESERVE_MAX_WEIGHT_PER_CYCLE=60

# --- External API URLs (optional — defaults are production values) ---
# HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
# HYPERLIQUID_STATS_URL=https://stats-data.hyperliquid.xyz/Mainnet
# HYPERLIQUID_UI_API_URL=https://api-ui.hyperliquid.xyz
# HYPURRSCAN_API_URL=https://api.hypurrscan.io
# HYPERFOLIO_API_URL=https://api.hyperfolio.xyz
# HYPERFOLIO_ASSETS_URL=https://hyperfolio.xyz
# HL_INDEXER_API_URL=https://api.hypedexer.com
#   (do NOT use api-eu.hypedexer.com — the host no longer resolves; every
#    /liquidations call fails with "fetch failed" and the circuit breaker opens)
# HYPEDEXER_WS_URL=wss://api.hypedexer.com/ws
# HYPEDEXER_LIVEDATA_WS_URL=wss://api.hypedexer.com/ws?mode=mirror
# Live-data sockets run side by side and merged (1 to 3, default 2): one
# dropping no longer drops the live TWAP book. 1 = a single socket, as before.
# HYPEDEXER_LIVEDATA_SOCKETS=2

# --- Telegram HIP-4 alerts (broadcast to all linked Telegram users) ---
# Set to false or 0 to disable HypeDexer hip4_events → Telegram pipeline.
# HIP4_TELEGRAM_ENABLED=true

# --- Hypurr Collective ecosystem sync (projects directory, content DB) ---
# Off by default. true = weekly check (6 h timer, last run kept in Redis).
# HYPURR_SYNC_ENABLED=false
# true = create missing projects + fill empty fields; otherwise each run only logs the diff.
# HYPURR_SYNC_APPLY=false
# HYPURR_SYNC_INTERVAL_DAYS=7
# HYPURR_SYNC_MAX_CREATES=50

# Elysium mainnet archive RPC (keyed URL from HypeDexer). Server-only: it backs the
# /elysium/rpc read-only proxy that powers the mainnet builder tools. Never ship to the client.
# ELYSIUM_MAINNET_RPC_URL=https://rpc.hypedexer.com/elysium/<key>
# Limits of that proxy (defaults shown; DATA_BUDGET BK-L-30, BK-L-31). Per client (IP or IPv6 /64),
# counted per JSON-RPC call at its weight (a plain read 1, a simulation one per simulated call,
# a log range 5), so a batch weighs its calls together:
# ELYSIUM_RPC_RATE_LIMIT_BURST=50
# ELYSIUM_RPC_RATE_LIMIT_MINUTE=1200
# For all clients together, per process, each with one client's share: forwards in flight (past
# its share a client's calls wait for one of its own), bytes of answers held in memory until
# delivered, weight a minute (set it under the key's real quota), bytes of one answer.
# ELYSIUM_RPC_MAX_IN_FLIGHT=64
# ELYSIUM_RPC_MAX_IN_FLIGHT_PER_CLIENT=8
# ELYSIUM_RPC_MAX_WAITING=256
# ELYSIUM_RPC_MAX_WAITING_PER_CLIENT=32
# ELYSIUM_RPC_MAX_BUFFERED_BYTES=100663296
# ELYSIUM_RPC_MAX_BUFFERED_BYTES_PER_CLIENT=25165824
# ELYSIUM_RPC_GLOBAL_PER_MINUTE=12000
# ELYSIUM_RPC_MAX_RESPONSE_BYTES=8388608

# Optional: explicit Elysium mainnet WS for the live block stream. Defaults to
# ELYSIUM_MAINNET_RPC_URL with https swapped to wss (same key). Server-only.
# ELYSIUM_MAINNET_WS_URL=wss://rpc.hypedexer.com/elysium/<key>

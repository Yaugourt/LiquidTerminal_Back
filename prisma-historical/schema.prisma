generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

/// Raw liquidation data from HypeDexer WebSocket/REST API
model RawLiquidation {
  id                 BigInt   @id @default(autoincrement())
  tid                BigInt   @unique
  time               DateTime @db.Timestamptz(3)
  timeMs             BigInt   @map("time_ms")
  coin               String   @db.VarChar(20)
  hash               String   @db.VarChar(255)
  liquidatedUser     String   @map("liquidated_user") @db.VarChar(255)
  sizeTotal          Decimal  @map("size_total") @db.Decimal(30, 10)
  notionalTotal      Decimal  @map("notional_total") @db.Decimal(30, 10)
  fillPxVwap         Decimal  @map("fill_px_vwap") @db.Decimal(30, 10)
  markPx             Decimal  @map("mark_px") @db.Decimal(30, 10)
  method             String   @db.VarChar(50)
  feeTotalLiquidated Decimal  @map("fee_total_liquidated") @db.Decimal(30, 10)
  liquidators        String[]
  liquidatorCount    Int      @map("liquidator_count")
  liqDir             String?  @map("liq_dir") @db.VarChar(10)
  rawData            Json     @map("raw_data")
  ingestedAt         DateTime @default(now()) @map("ingested_at") @db.Timestamptz(3)

  @@index([time])
  @@index([coin])
  @@index([liquidatedUser])
  @@index([coin, time])
  @@index([coin, liqDir, time])
  @@index([notionalTotal])
  @@index([liquidatedUser, time])
  @@index([time, notionalTotal])
  @@map("raw_liquidations")
}

/// Ingestion state watermark for monitoring and crash recovery
model IngestionState {
  id            Int      @id @default(1)
  lastTid       BigInt   @map("last_tid")
  lastTimeMs    BigInt   @map("last_time_ms")
  totalIngested BigInt   @default(0) @map("total_ingested")
  lastError     String?  @map("last_error") @db.Text
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("ingestion_state")
}

/// Hourly snapshot of the smart-money cohort's aggregate positioning, so the
/// net long/short bias can be charted over time. No upstream history exists for
/// open-position state, so we sample and store it ourselves (one row per hour).
model PositioningSnapshot {
  id             BigInt   @id @default(autoincrement())
  /// Hour bucket (floored to the hour). Unique so a repeated poll in the same
  /// hour overwrites rather than duplicates.
  time           DateTime @unique @db.Timestamptz(3)
  longNotional   Decimal  @map("long_notional") @db.Decimal(30, 2)
  shortNotional  Decimal  @map("short_notional") @db.Decimal(30, 2)
  netNotional    Decimal  @map("net_notional") @db.Decimal(30, 2)
  longShare      Decimal  @map("long_share") @db.Decimal(10, 6)
  tradersScanned Int      @map("traders_scanned")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([time])
  @@map("positioning_snapshots")
}

/// Generic hourly time-series of a scalar metric we sample ourselves because no
/// upstream endpoint returns its history (total open interest, active users, ...).
/// One row per (metric, hour); a repeated poll in the same hour overwrites via
/// the unique key. `meta` carries optional side values for future charts.
model MetricSnapshot {
  id        BigInt   @id @default(autoincrement())
  metric    String   @db.VarChar(64)
  /// Hour bucket (floored to the hour).
  time      DateTime @db.Timestamptz(3)
  value     Decimal  @db.Decimal(30, 4)
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([metric, time])
  @@index([metric, time])
  @@map("metric_snapshots")
}

// ============================================================================
// Elysium (Arbitrum Orbit L2 testnet settled on HyperEVM)
// Raw rows pulled from the provider's REST API by ElysiumIngestionService and
// aggregated in SQL by the /elysium/analytics routes. Every write is an
// idempotent upsert, so replaying an overlapping window is always safe.
// ============================================================================

/// One non-system Elysium transaction (spam kept, flagged by `isSpam`).
model ElysiumTx {
  txHash          String   @id @map("tx_hash") @db.VarChar(66)
  blockNumber     BigInt   @map("block_number")
  blockTime       DateTime @map("block_time") @db.Timestamptz(3)
  fromAddr        String   @map("from_addr") @db.VarChar(42)
  /// Null for contract creations.
  toAddr          String?  @map("to_addr") @db.VarChar(42)
  /// Set only when the transaction deployed a contract.
  contractAddress String?  @map("contract_address") @db.VarChar(42)
  methodId        String?  @map("method_id") @db.VarChar(10)
  /// EIP-2718 type as sent upstream (0x2 EIP-1559; 0x64/0x68/0x69 = Arbitrum
  /// deposit / submit-retryable / retry, i.e. bridge-driven txs).
  txType          String?  @map("tx_type") @db.VarChar(6)
  gasUsed         BigInt   @map("gas_used")
  /// gas_used * effective_gas_price, in wei.
  feeWei          Decimal  @map("fee_wei") @db.Decimal(38, 0)
  success         Boolean
  isSpam          Boolean  @map("is_spam")

  @@index([blockTime])
  @@index([toAddr, blockTime])
  @@index([fromAddr, blockTime])
  @@index([contractAddress])
  @@map("elysium_tx")
}

/// Contract deployed on Elysium, derived from txs whose contract_address is set.
model ElysiumContract {
  address     String   @id @db.VarChar(42)
  deployer    String   @db.VarChar(42)
  deployTx    String   @map("deploy_tx") @db.VarChar(66)
  deployedAt  DateTime @map("deployed_at") @db.Timestamptz(3)
  blockNumber BigInt   @map("block_number")

  @@index([deployedAt])
  @@index([deployer, deployedAt])
  @@map("elysium_contract")
}

/// Per-sender daily tx count (non-spam txs only), for active/new/retention.
model ElysiumAddressDay {
  address String   @db.VarChar(42)
  day     DateTime @db.Date
  txCount Int      @map("tx_count")

  @@id([address, day])
  @@index([day])
  @@map("elysium_address_day")
}

/// First time a sender was seen (non-spam txs only).
model ElysiumAddress {
  address   String   @id @db.VarChar(42)
  firstSeen DateTime @map("first_seen") @db.Timestamptz(3)
  firstDay  DateTime @map("first_day") @db.Date

  @@index([firstDay])
  @@map("elysium_address")
}

/// Bridge transfer between HyperEVM (L1) and Elysium (L2). Status evolves, so
/// rows are upserted with UPDATE on conflict.
model ElysiumBridgeTransfer {
  transferId  String    @id @map("transfer_id") @db.VarChar(80)
  direction   String    @db.VarChar(16)
  asset       String    @db.VarChar(16)
  route       String    @db.VarChar(16)
  status      String    @db.VarChar(24)
  symbol      String?   @db.VarChar(64)
  decimals    Int?
  fromAddr    String?   @map("from_addr") @db.VarChar(42)
  toAddr      String?   @map("to_addr") @db.VarChar(42)
  /// Human units (amount_raw / 10^decimals).
  amount      Decimal?  @db.Decimal(96, 18)
  l1TxHash    String?   @map("l1_tx_hash") @db.VarChar(66)
  l2TxHash    String?   @map("l2_tx_hash") @db.VarChar(66)
  initiatedAt DateTime  @map("initiated_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  durationS   Float?    @map("duration_s")
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([initiatedAt])
  @@index([direction, initiatedAt])
  @@index([fromAddr, initiatedAt])
  @@map("elysium_bridge_transfer")
}

/// Token registry snapshot (ERC-20) from the provider's /tokens listing.
model ElysiumToken {
  address       String    @id @db.VarChar(42)
  standard      String    @db.VarChar(16)
  name          String?   @db.VarChar(256)
  symbol        String?   @db.VarChar(128)
  decimals      Int?
  origin        String?   @db.VarChar(16)
  firstSeen     DateTime? @map("first_seen") @db.Timestamptz(3)
  transferCount BigInt    @default(0) @map("transfer_count")
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("elysium_token")
}

/// DEX pool created on Elysium: Uniswap V2 PairCreated / V3 PoolCreated logs.
/// `factory` is the emitting contract (log address).
model ElysiumDexPool {
  pool        String   @id @db.VarChar(42)
  factory     String   @db.VarChar(42)
  /// 'v2' (PairCreated) or 'v3' (PoolCreated).
  version     String   @db.VarChar(4)
  token0      String   @db.VarChar(42)
  token1      String   @db.VarChar(42)
  /// V3 fee tier in hundredths of a bip (e.g. 3000 = 0.3%); null for V2.
  fee         Int?
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)
  blockNumber BigInt   @map("block_number")
  txHash      String   @map("tx_hash") @db.VarChar(66)

  @@index([createdAt])
  @@index([factory])
  @@map("elysium_dex_pool")
}

/// One Uniswap V2 / V3 Swap log. Amounts are raw integers (token base units),
/// signed from the pool's point of view: positive = paid into the pool.
model ElysiumDexSwap {
  txHash      String   @map("tx_hash") @db.VarChar(66)
  logIndex    Int      @map("log_index")
  pool        String   @db.VarChar(42)
  version     String   @db.VarChar(4)
  blockTime   DateTime @map("block_time") @db.Timestamptz(3)
  blockNumber BigInt   @map("block_number")
  /// topic1 (usually a router), not necessarily the end user.
  sender      String   @db.VarChar(42)
  /// topic2 (V2 `to` / V3 `recipient`).
  recipient   String   @db.VarChar(42)
  amount0     Decimal  @db.Decimal(80, 0)
  amount1     Decimal  @db.Decimal(80, 0)

  @@id([txHash, logIndex])
  @@index([blockTime])
  @@index([pool, blockTime])
  @@map("elysium_dex_swap")
}

/// 4-byte method selector resolved via a public signature database. A null
/// signature means it was looked up and nothing was found (retried later).
model ElysiumMethodSig {
  methodId   String   @id @map("method_id") @db.VarChar(10)
  signature  String?  @db.Text
  /// Number of candidate signatures returned (collisions exist).
  candidates Int      @default(0)
  source     String   @db.VarChar(32)
  resolvedAt DateTime @default(now()) @map("resolved_at") @db.Timestamptz(3)

  @@map("elysium_method_sig")
}

/// Holder count / supply snapshot for the most active tokens only
/// (upstream /tokens/{address}), refreshed by the tokens stream.
model ElysiumTokenStat {
  address     String   @id @db.VarChar(42)
  holders     Int
  totalSupply Decimal? @map("total_supply") @db.Decimal(96, 18)
  fetchedAt   DateTime @default(now()) @map("fetched_at") @db.Timestamptz(3)

  @@map("elysium_token_stat")
}

/// A token launched on an Elysium launchpad (Chainzy, CorePad, Signal), from
/// the launchpad's own creation event. Holder stats are refreshed periodically.
model ElysiumLaunch {
  token       String    @id @db.VarChar(42)
  launchpad   String    @db.VarChar(16)
  /// curve (bonding curve), v3 (Uniswap V3 pool), v4 (Uniswap V4 pool).
  kind        String    @db.VarChar(8)
  creator     String?   @db.VarChar(42)
  createdAt   DateTime  @map("created_at") @db.Timestamptz(3)
  blockNumber BigInt    @map("block_number")
  txHash      String    @map("tx_hash") @db.VarChar(66)
  curve       String?   @db.VarChar(42)
  /// V3 pool, V2 pair (curve launches, after graduation) or V4 poolId.
  pool        String?   @db.VarChar(66)
  quote       String    @db.VarChar(42)
  name        String?   @db.VarChar(256)
  symbol      String?   @db.VarChar(128)
  graduatedAt DateTime? @map("graduated_at") @db.Timestamptz(3)
  holders     Int?
  top10Pct    Float?    @map("top10_pct")
  devPct      Float?    @map("dev_pct")
  statsAt     DateTime? @map("stats_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([curve])
  @@map("elysium_launch")
}

/// One trade on a launchpad token (curve, V2, V3 or V4). Amounts are raw
/// 18-decimal integers; price is quote per token after the trade.
model ElysiumLaunchTrade {
  txHash      String   @map("tx_hash") @db.VarChar(66)
  logIndex    Int      @map("log_index")
  token       String   @db.VarChar(42)
  venue       String   @db.VarChar(8)
  blockTime   DateTime @map("block_time") @db.Timestamptz(3)
  blockNumber BigInt   @map("block_number")
  trader      String?  @db.VarChar(42)
  isBuy       Boolean  @map("is_buy")
  quoteAmount Decimal  @map("quote_amount") @db.Decimal(80, 0)
  tokenAmount Decimal  @map("token_amount") @db.Decimal(80, 0)
  price       Float

  @@id([txHash, logIndex])
  @@index([token, blockTime])
  @@index([blockTime])
  @@map("elysium_launch_trade")
}

/// Watermark per ingestion stream (tx, bridge, tokens) for resume + monitoring.
model ElysiumIngestState {
  stream       String    @id @db.VarChar(32)
  cursor       DateTime? @db.Timestamptz(3)
  rows         BigInt    @default(0)
  backfillDone Boolean   @default(false) @map("backfill_done")
  lastError    String?   @map("last_error") @db.Text
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("elysium_ingest_state")
}

// ============================================================================
// Builder code growth
// Daily revenue and users per builder, aggregated from the per-builder daily
// fill files Hyperliquid publishes (stats-data.hyperliquid.xyz/Mainnet/
// builder_fills/<builder>/<YYYYMMDD>.csv.lz4) by BuilderGrowthService.
// ============================================================================

/// A builder whose daily files we ingest, with its own resume cursor.
model BuilderTracked {
  id           Int       @id @default(autoincrement())
  address      String    @unique @db.VarChar(42)
  name         String?   @db.VarChar(64)
  /// Discovery score: sampled compressed bytes of its daily files (activity proxy).
  score        BigInt    @default(0)
  /// Last day fully ingested (UTC date); null before the first file.
  cursor       DateTime? @db.Date
  backfillDone Boolean   @default(false) @map("backfill_done")
  lastError    String?   @map("last_error") @db.Text
  addedAt      DateTime  @default(now()) @map("added_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("builder_tracked")
}

/// One builder-day aggregate. Days without a file have no row (zero activity).
model BuilderDaily {
  builderId Int      @map("builder_id")
  day       DateTime @db.Date
  fees      Decimal  @db.Decimal(30, 6)
  volume    Decimal  @db.Decimal(30, 2)
  fills     Int
  users     Int
  newUsers  Int      @map("new_users")

  @@id([builderId, day])
  @@index([day])
  @@map("builder_daily")
}

/// First day each user traded through a builder, to count new users per day.
/// `userKey` is the first 8 bytes of the address as a signed int8 (addresses
/// are uniformly random, so collisions within one builder are negligible).
model BuilderUser {
  builderId Int      @map("builder_id")
  userKey   BigInt   @map("user_key")
  firstDay  DateTime @map("first_day") @db.Date

  @@id([builderId, userKey])
  @@index([builderId, firstDay])
  @@map("builder_user")
}

    "prisma:migrate:dev:historical": "prisma migrate dev --schema ./prisma-historical/schema.prisma --config ./prisma-historical/prisma.config.ts",
    "prisma:studio:historical": "prisma studio --schema ./prisma-historical/schema.prisma --config ./prisma-historical/prisma.config.ts",
    "cleanup-logs": "tsx scripts/cleanup-logs.ts cleanup",
    "log-stats": "tsx scripts/cleanup-logs.ts stats",
    "test-logs": "tsx scripts/test-log-rotation.ts",
    "migrate:csv": "tsx scripts/export-and-migrate-csv.ts",
    "hypedexer:inventory": "tsx scripts/hypedexer-openapi-inventory.ts",
    "hypedexer:required-query": "tsx scripts/hypedexer-openapi-required-query.ts"
  },

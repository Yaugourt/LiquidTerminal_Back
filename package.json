  "scripts": {
    "start": "npx prisma migrate deploy && npx prisma generate && npx prisma migrate deploy --schema ./prisma-historical/schema.prisma --config ./prisma-historical/prisma.config.ts && npx prisma generate --schema ./prisma-historical/schema.prisma && node dist/app.js",
    "start:dev": "tsx watch src/app.ts",
    "dev": "tsx watch src/app.ts",
    "start:prod": "NODE_ENV=production node dist/app.js",
    "build": "tsc",
    "build:clean": "rimraf dist && tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist node_modules/.cache",
    "prisma:generate": "prisma generate && prisma generate --schema ./prisma-historical/schema.prisma",
    "prisma:migrate": "prisma migrate deploy && prisma migrate deploy --schema ./prisma-historical/schema.prisma --config ./prisma-historical/prisma.config.ts",

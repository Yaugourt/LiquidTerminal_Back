{
  "name": "liquidterminal-backend",
  "version": "1.0.0",
  "description": "Production-grade REST API for the HyperLiquid ecosystem: aggregates real-time market data, manages user portfolios, and powers educational + gamification features.",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "start:dev": "tsx watch src/app.ts",
    "dev": "tsx watch src/app.ts",
    "start:prod": "NODE_ENV=production node dist/app.js",
    "build": "tsc",
    "build:clean": "rimraf dist && tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist node_modules/.cache",
    "prisma:generate": "prisma generate && prisma generate --schema ./prisma-historical/schema.prisma && prisma generate --schema ./prisma-content/schema.prisma && prisma generate --schema ./prisma-telegram/schema.prisma",
    "prisma:migrate": "prisma migrate deploy && prisma migrate deploy --schema ./prisma-historical/schema.prisma --config ./prisma-historical/prisma.config.ts && prisma migrate deploy --schema ./prisma-content/schema.prisma --config ./prisma-content/prisma.config.ts && prisma migrate deploy --schema ./prisma-telegram/schema.prisma --config ./prisma-telegram/prisma.config.ts",
    "prisma:studio": "prisma studio",
    "prisma:generate:historical": "prisma generate --schema ./prisma-historical/schema.prisma",
    "prisma:migrate:predeploy": "prisma migrate deploy && npm run prisma:migrate:historical",
    "prisma:migrate:historical": "prisma migrate deploy --schema ./prisma-historical/schema.prisma --config ./prisma-historical/prisma.config.ts",
    "prisma:migrate:dev:historical": "prisma migrate dev --schema ./prisma-historical/schema.prisma --config ./prisma-historical/prisma.config.ts",
    "prisma:studio:historical": "prisma studio --schema ./prisma-historical/schema.prisma --config ./prisma-historical/prisma.config.ts",
    "prisma:generate:content": "prisma generate --schema ./prisma-content/schema.prisma",
    "prisma:migrate:content": "prisma migrate deploy --schema ./prisma-content/schema.prisma --config ./prisma-content/prisma.config.ts",
    "prisma:migrate:dev:content": "prisma migrate dev --schema ./prisma-content/schema.prisma --config ./prisma-content/prisma.config.ts",
    "prisma:studio:content": "prisma studio --schema ./prisma-content/schema.prisma --config ./prisma-content/prisma.config.ts",
    "prisma:generate:telegram": "prisma generate --schema ./prisma-telegram/schema.prisma",
    "prisma:migrate:telegram": "prisma migrate deploy --schema ./prisma-telegram/schema.prisma --config ./prisma-telegram/prisma.config.ts",
    "prisma:migrate:dev:telegram": "prisma migrate dev --schema ./prisma-telegram/schema.prisma --config ./prisma-telegram/prisma.config.ts",
    "prisma:studio:telegram": "prisma studio --schema ./prisma-telegram/schema.prisma --config ./prisma-telegram/prisma.config.ts",
    "cleanup-logs": "tsx scripts/cleanup-logs.ts cleanup",
    "log-stats": "tsx scripts/cleanup-logs.ts stats",
    "test-logs": "tsx scripts/test-log-rotation.ts",
    "migrate:csv": "tsx scripts/export-and-migrate-csv.ts",
    "hypedexer:inventory": "tsx scripts/hypedexer-openapi-inventory.ts",
    "hypedexer:required-query": "tsx scripts/hypedexer-openapi-required-query.ts"
  },
  "keywords": [
    "hyperliquid",
    "trading",
    "api",
    "rest",
    "express",
    "typescript",
    "prisma",
    "redis",
    "defi",
    "liquidterminal"
  ],
  "author": "Liquid Terminal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yaugourt/LiquidTerminal_Back.git"
  },
  "bugs": {
    "url": "https://github.com/Yaugourt/LiquidTerminal_Back/issues"
  },
  "homepage": "https://liquidterminal.xyz",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/multer": "^2.3.0",
    "@types/pino": "^7.0.5",
    "axios": "^1.20.0",
    "cheerio": "^1.1.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "express": "^5.3.0",
    "ioredis": "^5.10.1",
    "jose": "^5.2.3",
    "lz4js": "^0.2.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.2.0",
    "sanitize-html": "^2.18.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^9.39.4",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
